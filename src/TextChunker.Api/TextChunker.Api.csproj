<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <Description>HTTP API (ASP.NET Core Minimal APIs) для TextChunker.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextChunker\TextChunker.csproj" />
    <ProjectReference Include="..\TextChunker.Abstractions\TextChunker.Abstractions.csproj" />
  </ItemGroup>

</Project>
