<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <Description>HTTP API (ASP.NET Core Minimal APIs) для TextChunker.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextChunker.Common\TextChunker.Common.csproj" />
    <ProjectReference Include="..\TextChunker.Abstractions\TextChunker.Abstractions.csproj" />
  </ItemGroup>

</Project>
