{
  "Chunking": {
    "MaxTextChars": 5000000,
    "TokenizerCacheDir": null
  },
  "ApiDocs": {
    "Enabled": true,
    "Route": "/scalar",
    "OpenApiRoute": "/openapi/{documentName}.json",
    "Title": "TextChunker API"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
